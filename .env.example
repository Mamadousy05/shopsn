# ==========================================================
# Copiez ce fichier en ".env" puis remplissez vos vraies clés.
# Ne partagez JAMAIS votre fichier .env (ne le mettez pas sur GitHub).
# ==========================================================

PORT=4000

# Mot de passe pour accéder à l'espace admin du site (à changer !).
# Si cette ligne est absente ou vide, "admin123" est utilisé par défaut.
ADMIN_PASSWORD=changez-moi

# URL publique de votre backend une fois déployé en ligne
# (ex: https://shopsn-api.mondomaine.com). En local pour les tests
# avec ngrok, mettez l'URL https fournie par ngrok.
PUBLIC_BASE_URL=http://localhost:4000

# ---------- INFOS VENDEUR (paiement manuel vérifié) ----------
# Utilisé tant que vous n'avez pas encore de compte marchand Wave/Orange
# Money avec accès API (nécessite un NINEA). Le client envoie l'argent
# directement à ces numéros personnels, puis vous confirmez la commande
# manuellement dans l'espace admin une fois le paiement reçu.
SELLER_NAME=Remplacez par le nom du vendeur
SELLER_WAVE_NUMBER=77 000 00 00
SELLER_ORANGE_NUMBER=77 000 00 00

# Numéro WhatsApp professionnel du vendeur qui recevra automatiquement le
# récapitulatif de chaque commande (envoyé par le CLIENT via un lien wa.me,
# donc aucune clé API n'est nécessaire ici — juste le numéro).
# Format obligatoire : indicatif + numéro, SANS le "+", sans espaces.
# Exemple pour le Sénégal : 221771234567
SELLER_WHATSAPP_NUMBER=221771234567

# ---------- NOTIFICATION WHATSAPP (optionnel, via CallMeBot) ----------
# Reçois une notification WhatsApp sur ton propre téléphone à chaque
# nouvelle commande. Service gratuit pour un usage personnel (un seul
# destinataire : toi-même). Pour obtenir CALLMEBOT_APIKEY :
# 1. Va sur https://www.callmebot.com/blog/free-api-whatsapp-messages/
#    pour voir le numéro actuel du bot (il change de temps en temps).
# 2. Ajoute ce numéro à tes contacts WhatsApp.
# 3. Envoie-lui le message : "I allow callmebot to send me messages"
# 4. Il te répond avec ton APIKEY personnel dans les 2 minutes.
CALLMEBOT_PHONE=+221 77 000 00 00
CALLMEBOT_APIKEY=

# ---------- WAVE BUSINESS (paiement automatique — nécessite un NINEA) ----------
# À récupérer sur business.wave.com (ou l'app Wave Business)
# une fois votre compte marchand validé : Développeurs > Clés API
WAVE_API_KEY=secret_remplacez_par_votre_cle_api_wave
# Clé fournie par Wave pour vérifier la signature des webhooks
WAVE_WEBHOOK_SECRET=whsec_remplacez_par_votre_secret_webhook

# ---------- ORANGE MONEY (Orange Developer) — paiement automatique, nécessite un compte marchand validé ----------
# Créez une app sur https://developer.orange.com pour obtenir :
ORANGE_CLIENT_ID=remplacez_par_votre_client_id
ORANGE_CLIENT_SECRET=remplacez_par_votre_client_secret
# Clé marchande fournie après validation de votre compte marchand Orange Money
ORANGE_MERCHANT_KEY=remplacez_par_votre_merchant_key
# Code pays Orange Money (sn = Sénégal)
ORANGE_COUNTRY=sn
